---
import { fill, langOf, textOf } from "../i18n";
import Base from "../layouts/Base.astro";
import { REPO_URL } from "../lib/release";

// Also /es/about/ and the other languages' (src/pages/<code>/about.astro).
// `services` in each language's file mirrors the Services list in the app's
// THIRD_PARTY_NOTICES.md. The heading ids stay the same in every language.
const lang = langOf(Astro.currentLocale);
const t = textOf(lang).about;
const links = { repo: REPO_URL, files: `${REPO_URL}/blob/main` };
---

<Base title={t.title} description={t.description}>
  <section class="section">
    <div class="container prose">
      <h1>{t.heading}</h1>
      <p set:html={fill(t.intro, links)} />
      <p>{t.copyright}</p>

      <h2 id="license">{t.licenseTitle}</h2>
      {t.license.map((text) => (
        <p set:html={fill(text, links)} />
      ))}

      <h2 id="source">{t.sourceTitle}</h2>
      <p set:html={fill(t.source, links)} />

      <h2 id="warranty">{t.warrantyTitle}</h2>
      <p>{t.warranty}</p>

      <h2 id="services">{t.servicesTitle}</h2>
      <p>{t.servicesText}</p>
      <ul class="services">
        {t.services.map((service) => (
          <li>
            <strong>{service.name}</strong>
            {service.note}
          </li>
        ))}
      </ul>

      <h2 id="privacy">{t.privacyTitle}</h2>
      {t.privacy.map((text) => (
        <p>{text}</p>
      ))}

      <h2 id="trademarks">{t.trademarksTitle}</h2>
      <p>{t.trademarks}</p>

      <h2 id="website">{t.websiteTitle}</h2>
      <p set:html={t.website} />
    </div>
  </section>
</Base>

<style>
  h1 {
    color: var(--font-primary);
    font-size: var(--font-display);
  }

  /* Rows, like the app's About. Scoped styles add no specificity, so this
     needs .prose to win over site.css's `.prose ul`. */
  .prose .services {
    gap: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .services li {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: 1px solid var(--border);
  }
</style>
