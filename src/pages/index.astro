---
import DownloadButton from "../components/DownloadButton.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { langOf, localize, textOf } from "../i18n";
import Base from "../layouts/Base.astro";
import { REPO_URL } from "../lib/release";

// Also /es/ and the other languages' homes (src/pages/<code>/index.astro)
const lang = langOf(Astro.currentLocale);
const t = textOf(lang).home;

// A line of an example: code, what Tokio says, or one of the app's rows (an
// alert's trigger and sound, an overlay and its tag)
type Part =
  | { code: string }
  | { text: string }
  | { name: string; value: string; sound?: boolean; verified?: boolean };

// The main features, each with a small, real example of what it does with
// the app's defaults, in its words
const FEATURES: {
  title: string;
  href: string;
  text: string;
  example: Part[];
}[] = (
  [
    ["tts", "/docs/features/text-to-speech/"],
    ["music", "/docs/features/music-requests/"],
    ["alerts", "/docs/features/alerts/"],
    ["games", "/docs/features/games/"],
    ["overlays", "/docs/features/overlays/"],
  ] as const
).map(([id, href]) => ({ ...t.features[id], href: localize(href, lang) }));

// The rest, under "And more", closed until it's clicked
const MORE = (
  [
    ["countdown", "/docs/features/countdown-timer/"],
    ["studio", "/docs/features/overlay-studio/"],
    ["history", "/docs/features/coin-stats/"],
    ["fans", "/docs/features/fans/"],
    ["translation", "/docs/features/chat-translation/"],
    ["controls", "/docs/features/live-controls/"],
    ["profiles", "/docs/features/profiles-and-settings/"],
    ["mcp", "/docs/developers/mcp/"],
  ] as const
).map(([id, href]) => ({
  ...t.more.features[id],
  href: localize(href, lang),
}));

// The docs' Features heading is #features in English, its own slug in others
const STEP_LINKS = [
  "/download/",
  `/docs/#${t.docsFeaturesAnchor}`,
  "/docs/guides/adding-an-overlay/",
  "/docs/connect/",
];
const STEPS = t.steps.map(({ title, text, link }, index) => ({
  title,
  text,
  link: { href: localize(STEP_LINKS[index], lang), label: link },
}));
---

<Base>
  <Hero />

  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <h2>{t.featuresTitle}</h2>
      </div>
      <ul class="features">
        {FEATURES.map((feature) => (
          <li>
            <h3>
              <a href={feature.href}>{feature.title}</a>
            </h3>
            <p>{feature.text}</p>
            <div class="example" aria-hidden="true">
              {feature.example.map((part) =>
                "code" in part ? (
                  <pre>{part.code}</pre>
                ) : "text" in part ? (
                  <p class="said">{part.text}</p>
                ) : (
                  <p class="row">
                    {part.name}
                    <span class:list={{ verified: part.verified }}>
                      {part.sound && <Icon name="music" size={14} />}
                      {part.verified && <Icon name="check" size={14} />}
                      {part.value}
                    </span>
                  </p>
                ),
              )}
            </div>
          </li>
        ))}
        <li class="more">
          <details>
            <summary>
              <h3>{t.more.title}</h3>
              <Icon name="chevron" />
            </summary>
            <ul class="others">
              {MORE.map((item) => (
                <li>
                  <a href={item.href}>{item.title}</a>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t.stepsTitle}</h2>
      </div>
      <ol class="steps">
        {STEPS.map((step, index) => (
          <li>
            <span class="step-number">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a href={step.link.href}>{step.link.label}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section cta">
    <div class="container cta-inner">
      <h2>{t.ctaTitle}</h2>
      <p class="muted">{t.ctaText}</p>
      <div class="actions">
        <DownloadButton size="lg" />
        <a class="btn btn-lg" href={REPO_URL}>
          <Icon name="github" size={20} />
          {t.viewOnGitHub}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The closing section's buttons, which it stacks on phones */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .features {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .features > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 960px) {
    .features > li {
      grid-template-columns: 220px minmax(0, 1fr) 340px;
      align-items: start;
    }
  }

  .features h3 {
    font-size: var(--font-xl);
  }

  .features h3 a,
  .others a {
    color: var(--font-primary);
    text-decoration: none;
  }

  .features h3 a:hover,
  .others a:hover {
    color: var(--accent-primary-hover);
    text-decoration: underline;
  }

  .features > li > p {
    max-width: 520px;
    color: var(--font-secondary);
  }

  /* Examples are panels: code in mono, the rest in the app's type */
  .example {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-tertiary);
    font-size: var(--font-md);
  }

  .example > * + * {
    border-top: 1px solid var(--border);
  }

  .example pre {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--font-primary);
    font-family: var(--font-family-mono);
    font-size: var(--font-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  .said {
    padding: var(--space-3) var(--space-4);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--control-height);
    padding: var(--space-1) var(--space-4);
  }

  .row span {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .row .verified :global(svg) {
    color: var(--success);
  }

  /* "And more": a row like the others that opens in place, the whole row
     its button. It holds the rest, two to a line from 720px, under the
     features' text from 960px. */
  .features > li.more {
    display: block;
    padding-block: 0;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    color: var(--font-secondary);
    transition: transform var(--transition-fast);
  }

  summary:hover h3,
  summary:hover :global(svg) {
    color: var(--accent-primary-hover);
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  /* Opens smoothly where browsers can animate to auto, at once elsewhere */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.25s ease-out,
      content-visibility 0.25s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  .others {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-8);
    margin: 0;
    padding: 0 0 var(--space-8);
    list-style: none;
  }

  @media (min-width: 720px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .others {
      margin-left: calc(220px + var(--space-8));
    }
  }

  .others li {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .others a {
    font-weight: 500;
  }

  .others p {
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  /* Timeline: vertical on phones, horizontal from 960px. Its track warms
     up to rose on the way to going LIVE. */
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: 0 0 var(--space-10) var(--space-12);
  }

  /* The track to the next step. The three tracks share one gradient, from
     the gray line at step 1 to rose at step 4. */
  .steps li::before {
    --from: var(--border);
    --to: color-mix(in srgb, var(--accent-primary) 33%, var(--border));

    content: "";
    position: absolute;
    top: 40px;
    bottom: var(--space-2);
    left: 15px;
    width: 2px;
    background: linear-gradient(var(--from), var(--to));
  }

  .steps li:nth-child(2)::before {
    --from: color-mix(in srgb, var(--accent-primary) 33%, var(--border));
    --to: color-mix(in srgb, var(--accent-primary) 67%, var(--border));
  }

  .steps li:nth-child(3)::before {
    --from: color-mix(in srgb, var(--accent-primary) 67%, var(--border));
    --to: var(--accent-primary);
  }

  .steps li:last-child::before {
    display: none;
  }

  .step-number {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--background-secondary-hover);
    border-radius: var(--radius-full);
    background: var(--background-primary);
    font-size: var(--font-md);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    /* Archivo's digits ride high in a line box: this centers them */
    padding-top: 0.15em;
  }

  .steps li:last-child .step-number {
    border: 2px solid var(--accent-primary);
  }

  .steps h3 {
    font-size: var(--font-xl);
  }

  .steps p {
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  .steps a {
    margin-top: var(--space-1);
    font-size: var(--font-md);
    font-weight: 500;
  }

  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8);
    }

    /* The text takes the spare height, so the links line up */
    .steps li {
      grid-template-rows: auto 1fr auto;
      align-content: stretch;
      padding: var(--space-12) 0 0;
    }

    .steps li::before {
      top: 15px;
      bottom: auto;
      left: 44px;
      right: calc(var(--space-2) - var(--space-8));
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--from), var(--to));
    }
  }

  .cta {
    border-top: 1px solid var(--border);
    background: radial-gradient(ellipse at bottom, var(--wash));
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .cta h2 {
    font-size: var(--font-title);
  }

  /* Stacked on phones, both as wide as the wider one */
  .cta .actions {
    display: grid;
    margin-top: var(--space-2);
  }

  @media (min-width: 720px) {
    .cta .actions {
      display: flex;
      justify-content: center;
    }
  }
</style>
