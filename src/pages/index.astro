---
import DownloadButton from "../components/DownloadButton.astro";
import Icon from "../components/Icon.astro";
import LiveFeed from "../components/LiveFeed.astro";
import Base from "../layouts/Base.astro";
import { getLatestRelease, REPO_URL } from "../lib/release";

const release = await getLatestRelease();

// Code, or rows drawn the way the app draws them
type Example =
  | string
  | { name: string; value?: string; current?: boolean; verified?: boolean }[];

// Each feature shows a small, real example of what it does.
const FEATURES: {
  title: string;
  href: string;
  text: string;
  example: Example;
}[] = [
  {
    title: "Text-to-speech",
    href: "/docs/features/text-to-speech/",
    text: "Chat is read aloud as it comes in, with TikTok, Microsoft Edge or your system's voices.",
    example: "{username} says {comment}\n→ Lucia says hi from Lima!",
  },
  {
    title: "Music requests",
    href: "/docs/features/music-requests/",
    text: "Viewers request songs from chat, played in Tokio's YouTube player or your Spotify app.",
    example: "!play One More Time\n!next  !last  !revoke",
  },
  {
    title: "Alerts",
    href: "/docs/features/alerts/",
    text: "A sound, an image or a video for follows, gifts, Super Fan events and more.",
    example: [
      { name: "Follow", value: "bell.mp3" },
      { name: "Gift", value: "confetti.mp4" },
      { name: "Share", value: "whoosh.mp3" },
    ],
  },
  {
    title: "Games",
    href: "/docs/features/games/",
    text: "Gifts, follows and chat spawn mobs and run commands in your Minecraft world.",
    example: 'Follow\n→ summon zombie "Lucia" ~ ~ ~',
  },
  {
    title: "Overlays",
    href: "/docs/features/overlays/",
    text: "Install the official overlays or import your own, then add each with one link.",
    // Tagged as the app's gallery tags them
    example: [
      { name: "Gift Jar", value: "Verified", verified: true },
      { name: "Top Likes", value: "Verified", verified: true },
      { name: "My chat box", value: "External" },
    ],
  },
  {
    title: "Countdown timer",
    href: "/docs/features/countdown-timer/",
    text: "A subathon clock on your stream that gifts, likes, follows and chat add time to.",
    // Rows of its Time Added settings, as the app words them
    example: [
      { name: "Coins", value: "1 second per coin" },
      { name: "Likes", value: "10 seconds every 100" },
      { name: "Follows", value: "30 seconds each" },
    ],
  },
  {
    title: "Profiles",
    href: "/docs/features/profiles-and-settings/",
    text: "Separate settings for different streams, switched from the title bar.",
    example: [
      { name: "Just chatting" },
      { name: "Music night", current: true },
      { name: "Gaming" },
    ],
  },
];

const STEPS = [
  {
    title: "Install Tokio",
    text: "For Windows, macOS or Linux. It checks for updates on its own.",
    link: { href: "/download/", label: "Download" },
  },
  {
    title: "Set it up",
    text: "Add your free Euler Stream key, then your voices, music, alerts and overlays.",
    link: { href: "/docs/#features", label: "Features" },
  },
  {
    title: "Prepare your stream",
    text: "Turn on the features you want, and add your overlays to OBS or TikTok LIVE Studio.",
    link: {
      href: "/docs/guides/adding-an-overlay/",
      label: "Adding an overlay",
    },
  },
  {
    title: "Go live and connect",
    text: "Start your LIVE on TikTok, then connect with your @username.",
    link: { href: "/docs/connect/", label: "How to connect" },
  },
];
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Make your TikTok LIVE react.</h1>
        <p class="lead">
          Tokio reads chat aloud, takes song requests, plays sounds and shows
          videos when someone follows or sends a gift, and drives the overlays
          in OBS, TikTok LIVE Studio or any streaming app that can show a web
          page.
        </p>
        <div class="actions">
          <DownloadButton size="lg" />
          <a class="btn btn-lg" href="/docs/">
            Read the docs
          </a>
        </div>
        <p class="meta">
          {[
            "Free and open source, for Windows, macOS and Linux.",
            release && `Version ${release.version}.`,
          ]
            .filter(Boolean)
            .join(" ")}
        </p>
      </div>
      <LiveFeed />
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <h2>What Tokio does</h2>
        <p>Turn each feature on or off for the session.</p>
      </div>
      <ul class="features">
        {FEATURES.map((feature) => (
          <li>
            <h3>
              <a href={feature.href}>{feature.title}</a>
            </h3>
            <p>{feature.text}</p>
            {typeof feature.example === "string" ? (
              <pre aria-hidden="true">{feature.example}</pre>
            ) : (
              <ul class="example" aria-hidden="true">
                {feature.example.map((row) => (
                  <li class:list={{ current: row.current }}>
                    {row.name}
                    {row.value && (
                      <span>
                        {row.verified && <Icon name="check" size={14} />}
                        {row.value}
                      </span>
                    )}
                    {row.current && <Icon name="check" size={14} />}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container overlay-grid">
      <div class="section-head">
        <h2>One link per overlay, in any streaming app</h2>
        <p>Each overlay gets its own address on your computer.</p>
        <p class="links">
          <a href="/overlays/">Browse the overlays</a>
          <a href="/docs/guides/adding-an-overlay/">How to add an overlay</a>
        </p>
      </div>
      <div class="card url-card">
        <p class="label">Browser source URL</p>
        <code>http://tokio-app.local:37891/&lt;overlay-id&gt;/</code>
        <ul>
          <li>
            <Icon name="check" size={18} /> OBS Studio
          </li>
          <li>
            <Icon name="check" size={18} /> TikTok LIVE Studio
          </li>
          <li>
            <Icon name="check" size={18} /> Any app with a browser source
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Live in four steps</h2>
      </div>
      <ol class="steps">
        {STEPS.map((step, index) => (
          <li>
            <span class="step-number">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a href={step.link.href}>{step.link.label}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section cta">
    <div class="container cta-inner">
      <h2>Ready for your next LIVE?</h2>
      <p class="muted">
        Tokio is free, open source and runs on your own computer.
      </p>
      <div class="actions">
        <DownloadButton size="lg" />
        <a class="btn btn-lg" href={REPO_URL}>
          <Icon name="github" size={20} />
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-16);
    background: radial-gradient(
      ellipse 70% 80% at 85% 0%,
      var(--accent-soft),
      transparent 70%
    );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: var(--space-20);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }

  .hero-copy {
    display: grid;
    gap: var(--space-6);
  }

  h1 {
    font-size: var(--font-display);
  }

  .lead {
    max-width: 560px;
    color: var(--font-secondary);
    font-size: var(--font-lg);
  }

  @media (min-width: 720px) {
    .lead {
      font-size: var(--font-xl);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .meta {
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .features {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .features > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 960px) {
    .features > li {
      grid-template-columns: 220px minmax(0, 1fr) 340px;
      align-items: start;
    }
  }

  .features h3 {
    font-size: var(--font-xl);
  }

  .features h3 a {
    color: var(--font-primary);
    text-decoration: none;
  }

  .features h3 a:hover {
    color: var(--accent-primary-hover);
    text-decoration: underline;
  }

  .features p {
    max-width: 520px;
    color: var(--font-secondary);
  }

  /* Examples are panels: code in mono, app rows in the app's type */
  pre,
  .example {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-tertiary);
  }

  pre {
    padding: var(--space-3) var(--space-4);
    color: var(--font-primary);
    font-family: var(--font-family-mono);
    font-size: var(--font-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  .example {
    padding: 0;
    list-style: none;
    font-size: var(--font-md);
  }

  .example li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--control-height);
    padding: var(--space-1) var(--space-4);
  }

  .example li + li {
    border-top: 1px solid var(--border);
  }

  .example span {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .example span :global(svg) {
    color: var(--success);
  }

  /* A menu marks its current row, like the app's profile menu */
  .example:has(.current) li:not(.current) {
    color: var(--font-secondary);
  }

  .example .current :global(svg) {
    color: var(--accent-primary);
  }

  .overlay-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .overlay-grid .section-head {
    margin-bottom: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  @media (min-width: 960px) {
    .overlay-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-16);
    }
  }

  .url-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .url-card .label {
    font-size: var(--font-sm);
    font-weight: 500;
  }

  /* The app's overlay card shows it in a field */
  .url-card code {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--font-primary);
    font-size: var(--font-md);
  }

  .url-card ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .url-card li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--font-secondary);
  }

  .url-card li :global(svg) {
    color: var(--success);
  }

  /* Timeline: vertical on phones, horizontal from 960px. Its track warms
     up to rose on the way to going LIVE. */
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: 0 0 var(--space-10) var(--space-12);
  }

  /* The track to the next step. The three tracks share one gradient, from
     the gray line at step 1 to rose at step 4. */
  .steps li::before {
    --from: var(--border);
    --to: color-mix(in srgb, var(--accent-primary) 33%, var(--border));

    content: "";
    position: absolute;
    top: 40px;
    bottom: var(--space-2);
    left: 15px;
    width: 2px;
    background: linear-gradient(var(--from), var(--to));
  }

  .steps li:nth-child(2)::before {
    --from: color-mix(in srgb, var(--accent-primary) 33%, var(--border));
    --to: color-mix(in srgb, var(--accent-primary) 67%, var(--border));
  }

  .steps li:nth-child(3)::before {
    --from: color-mix(in srgb, var(--accent-primary) 67%, var(--border));
    --to: var(--accent-primary);
  }

  .steps li:last-child::before {
    display: none;
  }

  .step-number {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--background-secondary-hover);
    border-radius: var(--radius-full);
    background: var(--background-primary);
    font-size: var(--font-md);
    font-weight: 600;
  }

  .steps li:last-child .step-number {
    border: 2px solid var(--accent-primary);
  }

  .steps h3 {
    font-size: var(--font-xl);
  }

  .steps p {
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  .steps a {
    margin-top: var(--space-1);
    font-size: var(--font-md);
    font-weight: 500;
  }

  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8);
    }

    /* The text takes the spare height, so the links line up */
    .steps li {
      grid-template-rows: auto 1fr auto;
      align-content: stretch;
      padding: var(--space-12) 0 0;
    }

    .steps li::before {
      top: 15px;
      bottom: auto;
      left: 44px;
      right: calc(var(--space-2) - var(--space-8));
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--from), var(--to));
    }
  }

  .cta {
    border-top: 1px solid var(--border);
    background: radial-gradient(
      ellipse at bottom,
      var(--accent-soft),
      transparent 70%
    );
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .cta h2 {
    font-size: var(--font-title);
  }

  /* Stacked on phones, both as wide as the wider one */
  .cta .actions {
    display: grid;
    margin-top: var(--space-2);
  }

  @media (min-width: 720px) {
    .cta .actions {
      display: flex;
      justify-content: center;
    }
  }
</style>
