---
import Icon from "../components/Icon.astro";
import { DEFAULT_LANG, fill, langOf, textOf } from "../i18n";
import Base from "../layouts/Base.astro";
import {
  FALLBACK_DOWNLOADS,
  formatSize,
  getLatestRelease,
  RELEASES_URL,
  type OS,
} from "../lib/release";

// Also /es/download/ and the other languages' (src/pages/<code>/download.astro)
const lang = langOf(Astro.currentLocale);
const t = textOf(lang).download;
const release = await getLatestRelease();
const downloads = release?.downloads ?? FALLBACK_DOWNLOADS;
const published = release
  ? new Date(release.publishedAt).toLocaleDateString(
      lang === DEFAULT_LANG ? "en-US" : lang,
      { year: "numeric", month: "long", day: "numeric" },
    )
  : undefined;

const OS_ICONS: Record<OS, "windows" | "apple" | "linux"> = {
  windows: "windows",
  mac: "apple",
  linux: "linux",
};
---

<Base title={t.title} description={t.description}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{t.heading}</h1>
        <p>{t.intro}</p>
        <p class="meta">
          {release ? (
            <>
              {fill(t.released, {
                version: release.version,
                date: published ?? "",
              })}{" "}
              <a href={release.url}>{t.releaseNotes}</a>
            </>
          ) : (
            <a href={RELEASES_URL}>{t.allReleases}</a>
          )}
        </p>
      </div>

      <ul class="downloads">
        {downloads.map((download) => (
          <li class="card download" data-os={download.os}>
            <Icon name={OS_ICONS[download.os]} size={28} />
            <div>
              <h2>{download.label}</h2>
              <p class="muted">
                {download.arch}
                {download.size && `, ${formatSize(download.size)}`}
              </p>
            </div>
            <span class="recommended">{t.yourSystem}</span>
            <a
              class="btn"
              href={download.url}
              aria-label={fill(t.downloadFor, {
                system: `${download.label} (${download.arch})`,
              })}
            >
              <Icon name="download" size={18} />
              {t.download}
            </a>
          </li>
        ))}
      </ul>

      <div class="notes">
        <div class="note">
          <h2>Windows</h2>
          <div>
            <p set:html={t.windows} />
            <details class="more">
              <summary>
                <span class="show">{t.readMore}</span>
                <span class="hide">{t.showLess}</span>
              </summary>
              <p set:html={t.windowsMore} />
            </details>
          </div>
        </div>
        <div class="note">
          <h2>Linux</h2>
          <p set:html={t.linux} />
        </div>
        <div class="note">
          <h2>macOS</h2>
          <div>
            <p set:html={t.mac} />
            <details class="more">
              <summary>
                <span class="show">{t.readMore}</span>
                <span class="hide">{t.showLess}</span>
              </summary>
              {t.macMore.map((text) => (
                <p set:html={text} />
              ))}
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { detectOS } from "../lib/os";

  const os = detectOS();
  if (os) {
    for (const card of document.querySelectorAll<HTMLElement>(
      `.download[data-os="${os}"]`,
    )) {
      card.classList.add("is-recommended");
      card.querySelector(".btn")?.classList.add("btn-primary");
    }
  }
</script>

<style>
  h1 {
    font-size: var(--font-display);
  }

  .meta {
    font-size: var(--font-md);
  }

  .downloads {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .download {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .download h2 {
    font-size: var(--font-xl);
  }

  .download p {
    font-size: var(--font-md);
  }

  /* Your system also gets the rose button */
  .recommended {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: none;
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .is-recommended .recommended {
    display: block;
  }

  /* The app's aside layout: the title beside its text. Rows, so opening
     one only makes that one taller. */
  .notes {
    margin-top: var(--space-10);
    border-bottom: 1px solid var(--border);
  }

  .note {
    display: grid;
    gap: var(--space-2) var(--space-10);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  @media (min-width: 720px) {
    .note {
      grid-template-columns: 200px minmax(0, 68ch);
    }
  }

  .note h2 {
    color: var(--font-primary);
    font-size: var(--font-lg);
  }

  .more summary {
    width: fit-content;
    margin-top: var(--space-2);
    color: var(--accent-primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--accent-primary);
  }

  .more[open] .show,
  .more:not([open]) .hide {
    display: none;
  }

  .more p {
    margin-top: var(--space-2);
  }
</style>
