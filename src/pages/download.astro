---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import {
  FALLBACK_DOWNLOADS,
  formatSize,
  getLatestRelease,
  RELEASES_URL,
  type OS,
} from "../lib/release";

const release = await getLatestRelease();
const downloads = release?.downloads ?? FALLBACK_DOWNLOADS;
const published = release
  ? new Date(release.publishedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : undefined;

const OS_ICONS: Record<OS, "windows" | "apple" | "linux"> = {
  windows: "windows",
  mac: "apple",
  linux: "linux",
};
---

<Base
  title="Download"
  description="Download Tokio for Windows, macOS and Linux."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Get Tokio</h1>
        <p>
          On Windows, a small installer downloads and installs the latest
          version of Tokio. On macOS and Linux you download Tokio itself: a zip
          with the app, or an AppImage. Once installed, Tokio checks for updates
          on its own.
        </p>
        <p class="meta">
          {release ? (
            <>
              Version {release.version}, released {published} ·{" "}
              <a href={release.url}>Release notes</a>
            </>
          ) : (
            <a href={RELEASES_URL}>See all releases</a>
          )}
        </p>
      </div>

      <ul class="downloads">
        {downloads.map((download) => (
          <li class="card download" data-os={download.os}>
            <span class="os-icon">
              <Icon name={OS_ICONS[download.os]} size={28} />
            </span>
            <div>
              <h2>{download.label}</h2>
              <p class="muted">
                {download.arch}
                {download.size && <> · {formatSize(download.size)}</>}
              </p>
            </div>
            <span class="recommended">Your system</span>
            <a class="btn" href={download.url}>
              <Icon name="download" size={18} />
              Download
            </a>
          </li>
        ))}
      </ul>

      <div class="notes">
        <div class="card note">
          <h2>macOS</h2>
          <p>
            Unzip it and move <strong>Tokio</strong> to your Applications
            folder. macOS may block it the first time, since Tokio isn't
            notarized yet.
          </p>
          <details class="more">
            <summary>
              <span class="show">Read more</span>
              <span class="hide">Show less</span>
            </summary>
            <p>
              To open it anyway, right-click it in Finder and choose{" "}
              <strong>Open</strong>, or allow it in{" "}
              <strong>System Settings → Privacy & Security</strong>.
            </p>
            <p>
              When an update is out, Tokio opens its release page so you can
              download the new zip.
            </p>
            <p>
              Not sure which Mac you have? Apple menu →{" "}
              <strong>About This Mac</strong>: "Apple M…" chips are Apple
              Silicon, "Intel" ones are Intel.
            </p>
          </details>
        </div>
        <div class="card note">
          <h2>Linux</h2>
          <p>
            Tokio comes as an AppImage. Make it executable with{" "}
            <code>chmod +x</code> (or in the file's properties) and run it.
            AppImages need FUSE.
          </p>
        </div>
        <div class="card note">
          <h2>Voices</h2>
          <p>
            TikTok and Microsoft Edge voices work everywhere. The voices
            installed on the system (SAPI and OneCore) are only available on
            Windows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head">
        <h2>Windows setup</h2>
        <p>
          Prefer to skip the installer on Windows? Every release also has
          Tokio's own setup.
        </p>
      </div>
      {release && release.packages.length > 0 ? (
        <ul class="packages">
          {release.packages.map((pkg) => (
            <li>
              <Icon name={OS_ICONS[pkg.os]} size={18} />
              <a href={pkg.url}>{pkg.file}</a>
              <span class="muted">
                {pkg.label} · {pkg.arch} · {formatSize(pkg.size)}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          <a href={RELEASES_URL}>Find it on the releases page</a>.
        </p>
      )}
      <p class="muted older">
        Looking for an older version?{" "}
        <a href={RELEASES_URL}>Browse all releases on GitHub</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { detectOS } from "../lib/os";

  const os = detectOS();
  if (os) {
    for (const card of document.querySelectorAll<HTMLElement>(
      `.download[data-os="${os}"]`,
    )) {
      card.classList.add("is-recommended");
      card.querySelector(".btn")?.classList.add("btn-primary");
    }
  }
</script>

<style>
  h1 {
    font-size: var(--font-display);
    font-weight: 800;
  }

  .meta {
    font-size: var(--font-md);
  }

  .downloads {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .download {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    transition: border-color var(--transition-fast);
  }

  .download h2 {
    font-size: var(--font-xl);
  }

  .download p {
    font-size: var(--font-md);
  }

  .os-icon {
    color: var(--font-primary);
  }

  .recommended {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: none;
    color: var(--accent-primary-hover);
    font-size: var(--font-sm);
    font-weight: 600;
  }

  .is-recommended {
    border-color: var(--accent-primary);
  }

  .is-recommended .recommended {
    display: block;
  }

  .notes {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    margin-top: var(--space-8);
  }

  .note {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  .note h2 {
    color: var(--font-primary);
    font-size: var(--font-lg);
  }

  .more summary {
    width: fit-content;
    color: var(--accent-primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--accent-primary);
  }

  .more[open] .show,
  .more:not([open]) .hide {
    display: none;
  }

  .more p {
    margin-top: var(--space-2);
  }

  .band {
    border-top: 1px solid var(--border);
    background: var(--background-tertiary);
  }

  .packages {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .packages li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--font-md);
  }

  .packages a {
    font-family: var(--font-family-mono);
    overflow-wrap: anywhere;
  }

  .older {
    margin-top: var(--space-8);
    font-size: var(--font-md);
  }
</style>
