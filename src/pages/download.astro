---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import {
  FALLBACK_DOWNLOADS,
  formatSize,
  getLatestRelease,
  RELEASES_URL,
  type OS,
} from "../lib/release";

const release = await getLatestRelease();
const downloads = release?.downloads ?? FALLBACK_DOWNLOADS;
const published = release
  ? new Date(release.publishedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : undefined;

const OS_ICONS: Record<OS, "windows" | "apple" | "linux"> = {
  windows: "windows",
  mac: "apple",
  linux: "linux",
};
---

<Base
  title="Download"
  description="Download Tokio for Windows, macOS and Linux."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Get Tokio</h1>
        <p>
          A setup on Windows, a zip on macOS, an AppImage on Linux. Tokio checks
          for updates on its own.
        </p>
        <p class="meta">
          {release ? (
            <>
              Version {release.version}, released {published}.{" "}
              <a href={release.url}>Release notes</a>
            </>
          ) : (
            <a href={RELEASES_URL}>See all releases</a>
          )}
        </p>
      </div>

      <ul class="downloads">
        {downloads.map((download) => (
          <li class="download" data-os={download.os}>
            <Icon name={OS_ICONS[download.os]} size={24} />
            <div class="what">
              <h2>{download.label}</h2>
              <p>
                {download.arch}
                {download.size && `, ${formatSize(download.size)}`}
              </p>
              <span class="recommended">Your system</span>
            </div>
            <a
              class="btn"
              href={download.url}
              aria-label={`Download for ${download.label} (${download.arch})`}
            >
              <Icon name="download" size={18} />
              Download
            </a>
          </li>
        ))}
      </ul>

      <div class="notes">
        <div class="note">
          <h2>macOS</h2>
          <div>
            <p>
              Unzip it and move <strong>Tokio</strong> to your Applications
              folder. macOS may block it the first time, since Tokio isn't
              notarized yet.
            </p>
            <details class="more">
              <summary>
                <span class="show">Read more</span>
                <span class="hide">Show less</span>
              </summary>
              <p>
                To open it anyway, right-click it in Finder and choose{" "}
                <strong>Open</strong>, or allow it in{" "}
                <strong>System Settings → Privacy & Security</strong>.
              </p>
              <p>
                When an update is out, Tokio opens its release page so you can
                download the new zip.
              </p>
              <p>
                Not sure which Mac you have? Apple menu →{" "}
                <strong>About This Mac</strong>: "Apple M…" chips are Apple
                Silicon, "Intel" ones are Intel.
              </p>
            </details>
          </div>
        </div>
        <div class="note">
          <h2>Linux</h2>
          <p>
            Tokio comes as an AppImage. Make it executable with{" "}
            <code>chmod +x</code> (or in the file's properties) and run it.
            AppImages need FUSE.
          </p>
        </div>
        <div class="note">
          <h2>Voices</h2>
          <p>
            TikTok and Microsoft Edge voices work everywhere. The voices
            installed on the system (SAPI and OneCore) are only available on
            Windows.
          </p>
        </div>
      </div>

      <p class="muted older">
        Looking for an older version?{" "}
        <a href={RELEASES_URL}>Browse all releases on GitHub</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { detectOS } from "../lib/os";

  const os = detectOS();
  if (os) {
    for (const row of document.querySelectorAll<HTMLElement>(
      `.download[data-os="${os}"]`,
    )) {
      row.classList.add("is-recommended");
      row.querySelector(".btn")?.classList.add("btn-primary");
    }
  }
</script>

<style>
  h1 {
    font-size: var(--font-display);
  }

  .meta {
    font-size: var(--font-md);
  }

  /* One panel of rows, like the app's features on Home */
  .downloads {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-tertiary);
  }

  .download {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
  }

  .download + .download {
    border-top: 1px solid var(--border);
  }

  .download > :global(svg) {
    flex: none;
  }

  .what {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .what h2 {
    font-size: var(--font-lg);
  }

  .what p {
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  /* Your system also gets the rose button */
  .recommended {
    display: none;
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .is-recommended .recommended {
    display: block;
  }

  @media (min-width: 720px) {
    .what {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
    }

    .what h2 {
      flex: none;
      width: 120px;
    }

    .recommended {
      margin-left: auto;
    }
  }

  /* The app's aside layout: the title beside its text. Rows, so opening
     one only makes that one taller. */
  .notes {
    margin-top: var(--space-10);
    border-bottom: 1px solid var(--border);
  }

  .note {
    display: grid;
    gap: var(--space-2) var(--space-10);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--font-secondary);
    font-size: var(--font-md);
  }

  @media (min-width: 720px) {
    .note {
      grid-template-columns: 200px minmax(0, 68ch);
    }
  }

  .note h2 {
    color: var(--font-primary);
    font-size: var(--font-lg);
  }

  .more summary {
    width: fit-content;
    margin-top: var(--space-2);
    color: var(--accent-primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--accent-primary);
  }

  .more[open] .show,
  .more:not([open]) .hide {
    display: none;
  }

  .more p {
    margin-top: var(--space-2);
  }

  .older {
    margin-top: var(--space-8);
    font-size: var(--font-md);
  }
</style>
