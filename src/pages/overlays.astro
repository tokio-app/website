---
import { getImage } from "astro:assets";
import { fill, langOf, localize, textOf } from "../i18n";
import Base from "../layouts/Base.astro";
import {
  getOverlays,
  OVERLAYS_RELEASE_URL,
  OVERLAYS_REPO_URL,
  type Overlay,
} from "../lib/overlays";
import { formatSize } from "../lib/release";

// Also /es/overlays/ and the other languages' (src/pages/<code>/overlays.astro).
// The overlays' names and descriptions come from the catalog, in English.
const lang = langOf(Astro.currentLocale);
const t = textOf(lang).overlays;
const overlays = await getOverlays();

// Each preview is resized at build time and served from this site. One that
// can't be fetched shows a placeholder instead of failing the build.
async function preview(overlay: Overlay) {
  if (!overlay.preview) return null;
  try {
    return await getImage({
      src: overlay.preview,
      inferSize: true,
      layout: "constrained",
      format: "webp",
      sizes: "(min-width: 960px) 560px, calc(100vw - 48px)",
    });
  } catch (error) {
    console.warn(
      `[overlays] No preview for ${overlay.id}: ${(error as Error).message}`,
    );
    return null;
  }
}

const items = await Promise.all(
  (overlays ?? []).map(async (overlay) => ({
    overlay,
    image: await preview(overlay),
  })),
);
---

<Base title={t.title} description={t.description}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>{t.heading}</h1>
        <p set:html={t.intro} />
        <p class="links">
          <a href={localize("/docs/features/overlays/", lang)}>
            {t.howTheyWork}
          </a>
          <a href={localize("/docs/developers/building-an-overlay/", lang)}>
            {t.makeYourOwn}
          </a>
        </p>
      </div>

      {overlays ? (
        <ul class="overlays">
          {items.map(({ overlay, image }) => (
            <li id={overlay.id}>
              <div class="preview">
                {image ? (
                  <img
                    src={image.src}
                    srcset={image.srcSet.attribute}
                    {...image.attributes}
                    alt={fill(t.previewOf, { name: overlay.name })}
                  />
                ) : (
                  <span class="muted">{t.noPreview}</span>
                )}
              </div>
              <div class="info">
                <h2>{overlay.name}</h2>
                <p class="description">{overlay.description}</p>
                <p class="meta">
                  {fill(t.version, { version: overlay.version })}{" "}
                  <a href={overlay.url}>{t.downloadZip}</a>{" "}
                  {`(${formatSize(overlay.size)})`}
                </p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">
          {t.loadFailed} <a href={OVERLAYS_RELEASE_URL}>{t.seeOnGitHub}</a>.
        </p>
      )}

      <p
        class="muted by-hand"
        set:html={fill(t.byHand, { repo: OVERLAYS_REPO_URL })}
      />
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--font-display);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--font-md);
    font-weight: 500;
  }

  .overlays {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .overlays li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-10);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
    /* Linked by id, below the sticky header */
    scroll-margin-top: var(--header-height);
  }

  @media (min-width: 960px) {
    .overlays li {
      grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
      align-items: center;
    }
  }

  /* Previews are 16:9 screenshots on the app's background */
  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-primary);
  }

  .preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  .info h2 {
    font-size: var(--font-2xl);
  }

  .description {
    max-width: 520px;
    color: var(--font-secondary);
  }

  .meta {
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .by-hand {
    max-width: 640px;
    margin-top: var(--space-8);
    font-size: var(--font-md);
  }
</style>
