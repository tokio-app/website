---
// Hero illustration: the app's Home during a LIVE, with the tally lit, and
// what Tokio does with each event.
import { langOf, textOf } from "../i18n";
import Icon from "./Icon.astro";

const t = textOf(langOf(Astro.currentLocale)).liveFeed;

// The app's sample numbers, as its readout shortens them in each language
const STATS = t.stats;

interface Event {
  name: string;
  // Chats show the message under the name, other events after it
  message?: string;
  action?: string;
  coins?: string;
  icon: "volume" | "bell" | "music" | "layers";
  reaction: string;
}

// Newest first, as the app's feed lists them
const ICONS = ["volume", "bell", "music", "layers"] as const;
const EVENTS: Event[] = t.events.map((event, index) => ({
  ...event,
  icon: ICONS[index],
}));
---

<figure class="home" aria-label={t.label}>
  <div class="head">
    <p class="title">{t.title}</p>
    <p class="status">
      <span class="dot"></span>
      <span>
        LIVE · <span class="timer">01:23:10</span>
      </span>
    </p>
  </div>

  <div class="stats">
    {STATS.map((stat) => (
      <p class="stat">
        <span class="value">{stat.value}</span>
        <span class="label">{stat.label}</span>
      </p>
    ))}
  </div>

  <ol class="feed">
    {EVENTS.map((event, index) => (
      <li style={`--delay: ${(EVENTS.length - 1 - index) * 0.6 + 0.4}s`}>
        <span class="avatar" aria-hidden="true">
          {event.name[0]}
        </span>
        <div class="body">
          <p>
            <strong>{event.name}</strong>
            {event.action && ` ${event.action}`}
            {event.coins && <span class="coins">{event.coins}</span>}
          </p>
          {event.message && <p class="message">{event.message}</p>}
          <p class="reaction">
            <Icon name={event.icon} size={14} />
            {event.reaction}
          </p>
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .home {
    position: relative;
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background-primary);
  }

  @media (min-width: 720px) {
    .home {
      padding: var(--space-6);
    }
  }

  /* On air: the app's tally, a rose line at the top's center, fading out to
     both sides */
  .home::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 25%;
    right: 25%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-primary) 35%,
      var(--accent-primary) 65%,
      transparent
    );
    animation: on-air 0.3s ease-out 0.1s both;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .title {
    font-size: var(--font-lg);
    font-weight: 600;
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-sm);
    font-weight: 600;
  }

  .timer {
    font-variant-numeric: tabular-nums;
  }

  /* Steady, like the tally */
  .dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--accent-primary);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* The readout: live numbers, condensed, with tabular figures */
  .value {
    font-size: var(--font-3xl);
    font-stretch: var(--stretch-readout);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .label {
    color: var(--font-secondary);
    font-size: var(--font-sm);
    font-weight: 500;
  }

  .feed {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-tertiary);
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-md);
    animation: arrive 0.5s ease-out both;
    animation-delay: var(--delay);
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--border);
    color: var(--font-secondary);
    font-size: var(--font-xs);
    font-weight: 600;
  }

  .body {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  strong {
    font-weight: 600;
  }

  .message,
  .coins {
    color: var(--font-secondary);
  }

  .coins {
    margin-left: var(--space-1);
    font-size: var(--font-sm);
  }

  /* What Tokio did with it */
  .reaction {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    color: var(--font-secondary);
    font-size: var(--font-sm);
  }

  .reaction :global(svg) {
    flex: none;
  }

  @keyframes on-air {
    from {
      opacity: 0;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
