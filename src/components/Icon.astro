---
// Line icons drawn for this site, plus brand icons from Starlight.
import { Icon as StarlightIcon } from "@astrojs/starlight/components";

const PATHS = {
  music:
    '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  gift: '<rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9"/><path d="M12 8v13"/><path d="M12 8c-2-4-6-4-6-1.5S12 8 12 8s6-.5 6-1.5S14 4 12 8z"/>',
  follow:
    '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M19 8v6"/><path d="M16 11h6"/>',
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  windows:
    '<path fill="currentColor" stroke="none" d="M3 5.5 10.5 4.5v7H3zM11.5 4.4 21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.4z"/>',
} as const;

const BRANDS = ["github", "apple", "linux"] as const;

type Name = keyof typeof PATHS | (typeof BRANDS)[number];

interface Props {
  name: Name;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const isBrand = (BRANDS as readonly string[]).includes(name);
---

{isBrand ? (
  <StarlightIcon
    name={name as (typeof BRANDS)[number]}
    size={`${size}px`}
    class={className}
  />
) : (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={PATHS[name as keyof typeof PATHS]}
  />
)}
