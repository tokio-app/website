---
// A screenshot of the app from src/assets/screenshots/. They're taken at 2x,
// so half the pixel width is the app's own size: shown at that width, or
// narrower to fit the text column, crisp on HiDPI screens and never enlarged.
// Other languages' pages show the app in their language, from
// src/assets/screenshots/<code>/, or the English one while it's missing.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { DEFAULT_LANG, langOf } from "../i18n";

interface Props {
  // The file name in src/assets/screenshots/, without .png
  name: string;
  alt: string;
}

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/**/*.png",
  { eager: true },
);

const { name, alt } = Astro.props;
const lang = langOf(Astro.currentLocale);
const file = (folder: string) =>
  screenshots[`../assets/screenshots/${folder}${name}.png`]?.default;
const src = (lang === DEFAULT_LANG ? undefined : file(`${lang}/`)) ?? file("");
if (!src) {
  throw new Error(`No screenshot named "${name}" in src/assets/screenshots/`);
}
const width = Math.round(src.width / 2);
---

<Image
  src={src}
  alt={alt}
  width={width}
  densities={[1, 2]}
  class="screenshot"
/>
