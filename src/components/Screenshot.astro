---
// A screenshot of the app from src/assets/screenshots/. They're taken at 2x,
// so half the pixel width is the app's own size: shown at that width, crisp
// on HiDPI screens, and never enlarged. Wide ones spread past the text column
// on large screens (starlight.css).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  // The file name in src/assets/screenshots/, without .png
  name: string;
  alt: string;
}

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.png",
  { eager: true },
);

const { name, alt } = Astro.props;
const src = screenshots[`../assets/screenshots/${name}.png`]?.default;
if (!src) {
  throw new Error(`No screenshot named "${name}" in src/assets/screenshots/`);
}
const width = Math.round(src.width / 2);
---

<Image
  src={src}
  alt={alt}
  width={width}
  densities={[1, 2]}
  class="screenshot"
  style={`--w: ${width}px`}
/>
