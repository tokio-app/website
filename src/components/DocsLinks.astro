---
// Replaces Starlight's SocialIcons (astro.config.mjs): the site header's
// Overlays, Download and About links come before the GitHub icon, in the
// docs header from 72rem up, where they fit beside the centered search.
// Narrower, and in the phone menu, the sidebar's More group has them.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { langOf, localize, textOf } from "../i18n";

const lang = langOf(Astro.currentLocale);
const t = textOf(lang).header;
const LINKS = [
  { href: "/overlays/", label: t.overlays },
  { href: "/download/", label: t.download },
  { href: "/about/", label: t.about },
].map((link) => ({ ...link, href: localize(link.href, lang) }));
---

<div class="links">
  {LINKS.map((link) => (
    <a href={link.href}>{link.label}</a>
  ))}
</div>
<Default />

<style>
  /* Quiet, like the site header's links */
  .links {
    display: none;
    gap: var(--space-1);
  }

  .links a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--font-secondary);
    font-size: var(--font-md);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .links a:hover {
    color: var(--font-primary);
  }

  @media (min-width: 72rem) {
    .links {
      display: flex;
    }
  }
</style>
