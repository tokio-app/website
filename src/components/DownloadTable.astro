---
// The download table of the Install docs, with the latest release's file
// names. Without release data, the rows link to the release page.
import { langOf, textOf } from "../i18n";
import { FALLBACK_DOWNLOADS, getLatestRelease } from "../lib/release";

const t = textOf(langOf(Astro.currentLocale)).downloadTable;
const release = await getLatestRelease();
const rows = release?.downloads ?? FALLBACK_DOWNLOADS;
---

<table>
  <thead>
    <tr>
      <th>{t.system}</th>
      <th>{t.download}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((d) => (
      <tr>
        <td>
          {d.label} ({d.arch})
        </td>
        <td>
          <a href={d.url}>{d.file ? <code>{d.file}</code> : t.latestRelease}</a>
        </td>
      </tr>
    ))}
  </tbody>
</table>
