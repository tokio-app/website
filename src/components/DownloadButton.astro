---
// Links to the download page, or straight to the download when the visitor's
// OS has a single one: the setup on Windows, the AppImage on Linux. Their
// names carry the version, so they only get a direct link when the build could
// read the latest release.
import { langOf, localize, textOf } from "../i18n";
import { FALLBACK_DOWNLOADS, getLatestRelease } from "../lib/release";
import Icon from "./Icon.astro";

interface Props {
  size?: "md" | "lg";
}

const { size = "md" } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = textOf(lang).downloadButton;
const release = await getLatestRelease();
const direct = Object.fromEntries(
  (release?.downloads ?? FALLBACK_DOWNLOADS)
    .filter((d) => d.os !== "mac" && d.file)
    .map((d) => [d.os, d.url]),
);
---

<a
  class:list={["btn", "btn-primary", { "btn-lg": size === "lg" }]}
  href={localize("/download/", lang)}
  data-download-button
  data-windows={direct.windows}
  data-linux={direct.linux}
  data-label-for={t.labelFor}
>
  <Icon name="download" size={size === "lg" ? 20 : 18} />
  <span data-label>{t.label}</span>
</a>

<script>
  import { detectOS, OS_LABELS } from "../lib/os";

  const os = detectOS();
  if (os) {
    for (const button of document.querySelectorAll<HTMLAnchorElement>(
      "[data-download-button]",
    )) {
      const label = button.querySelector("[data-label]");
      const text = button.dataset.labelFor;
      if (label && text)
        label.textContent = text.replace("{os}", OS_LABELS[os]);
      const url = os === "mac" ? undefined : button.dataset[os];
      if (url) button.href = url;
    }
  }
</script>
